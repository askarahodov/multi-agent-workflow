# Optional: copy to .env before storing real provider API credentials.
# Generate a unique base64-encoded 32-byte key, keep it private and stable.
# Never use the example itself as a secret.
AUTH_ENCRYPTION_KEY=

# Optional host port overrides. Container-internal ports remain unchanged.
# 8000, 8080 and 8081 are intentionally not used as default host ports.
ORCH_HOST_PORT=18000
AGENT_MGMT_HOST_PORT=8001
RUNTIME_HOST_PORT=8002
QG_HOST_PORT=8003
FRONTEND_HOST_PORT=5173
POSTGRES_HOST_PORT=5432

# Optional outbound HTTP(S) proxy for Python API services and an explicitly
# opted-in native-worker overlay. Never put a real credential in this file:
# enter it in the git-ignored .env on your machine (chmod 600 on Linux).
# HTTP proxy URLs can carry userinfo; percent-encode reserved characters.
# Leave blank to use direct networking.
MAW_OUTBOUND_PROXY_URL=
# Do not send Docker-internal calls, TLS control/gateway or local healthchecks
# to an external proxy. Override only if your infrastructure needs it.
MAW_OUTBOUND_NO_PROXY=localhost,127.0.0.1,::1,orchestration-server,agent-management,runtime-hardening,quality-gates,frontend,postgres,secure-orchestration,trusted-gateway
