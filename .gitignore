# Python
__pycache__/
*.py[cod]
*.egg-info/
.qg-verify/
.verify/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node / frontend
node_modules/
dist/
coverage/
.coverage
*.coverage
.vite/
playwright-report/
test-results/

# Terraform / misc
*.tfstate*
.DS_Store
*.log

# Tooling / generated artifacts
.worktrees/
/worktrees/
# GitFlow policy injection artefacts (generated per-workspace, never committed)
.githooks
.agent-gitflow.json
.agent-gitflow.env
.agent-gitflow.env.tmp
AGENT_GITFLOW_CONTEXT.json
shared/build/
runtime-hardening/reports/benchmarks.json

# Throwaway OpenAPI verification scripts (docs/openapi.json is not generated in-repo)
orchestration-server/check_openapi_match.py
orchestration-server/validate_openapi.py

# Local secrets and per-host environment overrides (never commit).
.env
.env.*
!.env.example
.envrc
.direnv/

# Local IDE/agent state
.hermes/
PLAN.json
docker-compose.override.yml
docker/

# Local protected stack artifacts, operator-only credentials and API smoke IDs
.local/
.local-*/
.maw-*
secrets/
compose.override.yml
local-*.txt
/smoke.json
/smoke-*.json
/maw-smoke*.json
# SQLite databases and their WAL/rollback sidecars must never be committed.
# .gitignore alone does NOT untrack files already indexed: #311 removes one.
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
.worktrees/

# Local TLS material / test fixtures (never commit private keys)
certs/
*.pem
*.key
