# Opt-in trusted gateway image; do not start TLS or create the tool ledger by default.
# The production TLS process must be explicitly configured by its operator.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /opt/maw
COPY shared /opt/maw/shared
COPY agent-management /opt/maw/agent-management
RUN python -m pip install --no-cache-dir /opt/maw/shared /opt/maw/agent-management \
    && useradd --system --uid 10002 --no-create-home --shell /usr/sbin/nologin maw-gateway
USER 10002:10002
# No port is published; the default command refuses to execute side effects.
CMD ["python", "-m", "agent_management.trusted_gateway_cli", "preflight"]
