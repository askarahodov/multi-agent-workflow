{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workflow-editor/schemas/workflow.schema.json",
  "title": "WorkflowDefinition",
  "description": "Canonical Workflow Definition document (schema_version 1.0). Graph-level invariants (single start, at least one end, no cycles, reachability, unique ids, dangling endpoints, required agent references) are enforced by the graph validator and are intentionally not encoded here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "metadata", "nodes", "edges"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "created_at"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "nodeTypes": {
      "type": "string",
      "enum": [
        "start",
        "agent",
        "condition",
        "gate",
        "parallel",
        "join",
        "human_approval",
        "tool",
        "memory",
        "delay",
        "end"
      ]
    },
    "errorActions": {
      "type": "string",
      "enum": ["fail", "retry", "skip"]
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label", "position", "config"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/nodeTypes"
        },
        "label": {
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "config": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_node_id",
        "target_node_id",
        "output_mapping",
        "on_error",
        "max_retries"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_node_id": {
          "type": "string",
          "minLength": 1
        },
        "target_node_id": {
          "type": "string",
          "minLength": 1
        },
        "output_mapping": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "condition": {
          "type": "string"
        },
        "on_error": {
          "$ref": "#/$defs/errorActions"
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}