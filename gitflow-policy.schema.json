{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GitFlow Policy Schema",
  "description": "Machine-readable mirror of AGENT_GITFLOW_RULES.md (YAML front-matter). Consumed by the GitFlow hooks, the dispatcher policy injection (scripts/git/gitflow_context.py) and the CI job .github/workflows/gitflow-policy.yml.",
  "version": "1.0.0",
  "type": "object",
  "required": ["version", "rules", "branch_taxonomy", "commit_format", "merge_policy", "lifecycle"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "enforcement"],
        "properties": {
          "id": { "type": "string", "pattern": "^GF-\\d{2}$" },
          "description": { "type": "string" },
          "enforcement": { "type": "string", "enum": ["hook", "ci", "branch-protection", "review", "manual"] }
        }
      }
    },
    "branch_taxonomy": {
      "type": "object",
      "required": ["agent_pattern", "human_prefixes", "forbidden_patterns"],
      "properties": {
        "agent_pattern": { "type": "string", "const": "^wt/t_[a-f0-9]{8}$" },
        "human_prefixes": { "type": "array", "items": { "type": "string" } },
        "forbidden_patterns": { "type": "array", "items": { "type": "string" } }
      }
    },
    "commit_format": {
      "type": "object",
      "required": ["pattern", "types", "max_subject_length"],
      "properties": {
        "pattern": { "type": "string" },
        "types": { "type": "array", "items": { "type": "string" } },
        "max_subject_length": { "type": "integer", "const": 72 }
      }
    },
    "merge_policy": {
      "type": "object",
      "required": ["agent_branches", "release_branches", "protected_branches"],
      "properties": {
        "agent_branches": { "type": "string", "const": "squash" },
        "release_branches": { "type": "string", "const": "merge-commit" },
        "protected_branches": { "type": "array", "items": { "type": "string" } }
      }
    },
    "lifecycle": {
      "type": "object",
      "required": ["review_rebase_hours", "hard_max_hours", "abandonment_days", "cleanup_immediate"],
      "properties": {
        "review_rebase_hours": { "type": "integer", "const": 24 },
        "hard_max_hours": { "type": "integer", "const": 48 },
        "abandonment_days": { "type": "integer", "const": 7 },
        "cleanup_immediate": { "type": "boolean", "const": true }
      }
    }
  }
}
