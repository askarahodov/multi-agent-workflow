{
  "name": "multi-agent-workflow",
  "version": "0.1.0-rc1",
  "description": "Multi-Agent Workflow System - Autonomous AI agent orchestration platform",
  "private": true,
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:check-links": "vitepress build docs && node scripts/check-links.js docs/.vitepress/dist",
    "test": "pytest",
    "test:cov": "pytest --cov=src --cov-report=term-missing --cov-report=xml",
    "lint": "ruff check . && mypy src",
    "lint:fix": "ruff check --fix .",
    "format": "ruff format .",
    "security:scan": "bandit -r src && safety check && trivy fs .",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "kanban": "hermes-kanban"
  },
  "keywords": [
    "ai-agents",
    "orchestration",
    "kanban",
    "autonomous",
    "llm",
    "workflow"
  ],
  "author": "Multi-Agent Workflow Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/multi-agent-workflow.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/multi-agent-workflow/issues"
  },
  "homepage": "https://github.com/your-org/multi-agent-workflow#readme",
  "engines": {
    "node": ">=20.0.0",
    "python": ">=3.11.0"
  },
  "packageManager": "npm@10.0.0",
  "devDependencies": {
    "@vueuse/core": "^10.0.0",
    "katex": "^0.16.0",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-anchor": "^8.6.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-deflist": "^3.0.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-katex": "^2.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-mermaid": "^0.2.5",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-table-of-contents": "^0.6.0",
    "markdown-it-task-lists": "^2.1.0",
    "mermaid": "^10.0.0",
    "vitepress": "^1.3.0",
    "vue": "^3.4.0"
  },
  "volta": {
    "node": "20.11.0",
    "npm": "10.2.0"
  },
  "type": "module",
  "dependencies": {
    "vitepress-plugin-mermaid": "^2.0.17"
  }
}
