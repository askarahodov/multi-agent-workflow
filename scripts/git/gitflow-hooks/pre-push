#!/usr/bin/env bash
# pre-push hook — GitFlow enforcement layer L3.
#
# Invoked by git as: pre-push <remote-name> <remote-url>
# stdin: one line per ref being pushed — "<local-ref> <local-sha> <remote-ref> <remote-sha>"
#
# Blocks (see AGENT_GITFLOW_RULES.md):
#   * GF-05  any push to a protected branch (main / master / develop /
#            release/* / hotfix/*) — direct push and force-push alike;
#   * GF-05  force-push (non-fast-forward) to a protected branch;
#   * squash-merge attempts — a rewritten/squashed history pushed at a
#            protected ref, or a commit carrying git's "Squashed commit of the
#            following" marker;
#   * GF-02  a branch name that carries neither a task id nor a human prefix;
#   * a push whose branch head is known-red in CI (best-effort, when `gh` is
#            available) — see GITFLOW_SKIP_CI_CHECK.
#
# Bypass (audited): `git push --no-verify`. The CI job `gitflow-policy.yml`
# re-validates the PR after the fact, so a bypass is still caught.

set -u

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/git/gitflow-hooks/gitflow-lib.sh
. "$HOOK_DIR/gitflow-lib.sh"

# SEC-010/SEC-002: refuse when core.hooksPath has been redirected.
if ! gitflow_verify_hookspath; then
    gf_error "SEC-010: core.hooksPath is not '$GITFLOW_HOOKS_PATH' — refusing to run."
    exit 1
fi

remote_name="${1:-origin}"
remote_url="${2:-}"
zero='0000000000000000000000000000000000000000'
status=0

# --- CI status (best effort) ----------------------------------------------
# Returns 0 when the given commit is known-green OR unknown, 1 when it has a
# failing check/status. Never blocks when `gh` is unavailable.
ci_green_or_unknown() {
    local sha="${1:-}"
    [ -n "${GITFLOW_SKIP_CI_CHECK:-}" ] && return 0
    command -v gh >/dev/null 2>&1 || return 0
    case "$remote_url" in
        *github.com*) ;;
        *) return 0 ;;
    esac
    [ -z "$sha" ] || [ "$sha" = "$zero" ] && return 0
    local state
    state="$(gh api "repos/{owner}/{repo}/commits/$sha/status" --jq '.state' 2>/dev/null || true)"
    case "$state" in
        failure|error) return 1 ;;
        success|pending|"") return 0 ;;
    esac
    return 0
}

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "${local_ref:-}" ] && continue
    remote_branch="${remote_ref#refs/heads/}"
    local_branch="${local_ref#refs/heads/}"

    # --- deletion of a remote branch -------------------------------------
    if [ "$local_sha" = "$zero" ]; then
        if is_protected_branch "$remote_branch"; then
            gf_error "GF-05: refusing to delete protected remote branch '$remote_branch'."
            status=1
        fi
        continue
    fi

    # --- GF-05: push/force-push to a protected branch --------------------
    if is_protected_branch "$remote_branch"; then
        if [ "$remote_sha" = "$zero" ]; then
            gf_error "GF-05: refusing to create/update protected branch '$remote_branch' directly."
        elif git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
            gf_error "GF-05: refusing a direct push to protected branch '$remote_branch'."
        else
            gf_error "GF-05: refusing a force-push (non-fast-forward) to protected branch '$remote_branch'."
        fi
        gf_error "  All changes land through a reviewed PR (squash merge). Branch: wt/<task-id>."
        status=1
        continue
    fi

    # --- squash-merge attempts -------------------------------------------
    if [ "$remote_sha" != "$zero" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
        gf_warn "squash/rewrite detected on '$local_branch' (non-fast-forward). Allowed before review on your own branch."
    fi
    if [ "$remote_sha" != "$zero" ]; then
        if git log --format=%s "$remote_sha..$local_sha" 2>/dev/null | grep -q '^Squashed commit of the following'; then
            gf_error "squash-merge: branch '$local_branch' contains a 'Squashed commit of the following' commit."
            gf_error "  Squash happens at the PR merge, not on the feature branch. Remove it: git rebase -i origin/main"
            status=1
            continue
        fi
    fi

    # --- GF-02: branch naming --------------------------------------------
    if [ "$local_ref" != "$remote_ref" ]; then
        gf_warn "pushing local '$local_branch' to remote '$remote_branch' — verify this is intended."
    fi
    if ! validate_branch_name "$local_branch"; then
        gf_error "GF-02: branch name '$local_branch' is not allowed."
        gf_error "$GITFLOW_BRANCH_HINT"
        status=1
        continue
    fi

    # --- CI green ---------------------------------------------------------
    if ! ci_green_or_unknown "$remote_sha"; then
        gf_error "CI is not green for $remote_branch @ ${remote_sha:0:12}; refusing to push."
        gf_error "  Fix the failing checks, or set GITFLOW_SKIP_CI_CHECK=1 to override (audited)."
        status=1
        continue
    fi
done

exit "$status"
