# Opt-in native worker image: no Hermes, no Docker socket, no workspace/DB.
# Build context must be repository root; credentials are provided only at runtime.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /opt/maw

COPY packages/shared /opt/maw/shared
COPY agent-management /opt/maw/agent-management
COPY orchestration-server /opt/maw/orchestration-server

RUN python -m pip install --no-cache-dir \
      /opt/maw/shared /opt/maw/agent-management \
      '/opt/maw/orchestration-server[native-worker]' \
    && useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin maw-worker \
    && rm -rf /root/.cache/pip

USER 10001:10001

# Deliberately does NOT run provider calls or polls on docker compose up.
CMD ["python", "-m", "orchestration_server.native_worker_cli", "preflight"]
