# Opt-in secure orchestration image. No state or credentials included.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install --no-install-recommends -y git \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/maw
COPY packages/shared /opt/maw/shared
COPY orchestration-server /opt/maw/orchestration-server
RUN python -m pip install --no-cache-dir /opt/maw/shared /opt/maw/orchestration-server \
    && useradd --system --uid 10002 --no-create-home --shell /usr/sbin/nologin maw-control
USER 10002:10002
# Explicit process command only through protected Compose deployment.
CMD ["python", "-m", "orchestration_server.secure_sqlite_serve"]
