# services/quality-gates — production release image (source-baked).
#
# Unlike services/quality-gates/Dockerfile (the local-dev image, which installs runtime
# dependencies into /app/.venv and relies on docker-compose bind-mounting the
# source tree), this image COPYs the application source. The published artifact
# is therefore standalone-runnable: `docker run` boots the API with no host bind
# mounts.
#
# Build context is the repository ROOT (release.yml builds with context: ".").
# Base image: python:3.12-slim — the same base as the hardened variants
# (Dockerfile.native-qa). This repository does not pin base-image digests.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /opt/maw

# First-party shared package plus the subsystem source. `shared` is installed
# first so the `maw-shared==0.1.0` requirement in services/quality-gates' pyproject
# resolves locally instead of hitting PyPI.
COPY packages/shared /opt/maw/shared
COPY services/quality-gates /opt/maw/quality-gates

# Install the packages (pulls runtime deps from services/quality-gates/pyproject.toml) and
# create the dedicated non-root service identity. uid/gid 10005 follows the
# project-wide release-image convention.
RUN python -m pip install --no-cache-dir \
        /opt/maw/shared /opt/maw/quality-gates \
    && useradd --system --uid 10005 --no-create-home --shell /usr/sbin/nologin maw-qg \
    && rm -rf /root/.cache/pip

# Writable state directory for the non-root runtime: the service creates its
# SQLite database plus ./evidence_store and ./release_artifacts relative to the
# working directory. Override DATABASE_URL / QG_EVIDENCE_ROOT / QG_ARTIFACT_ROOT
# to relocate them.
RUN install -d -o 10005 -g 10005 /var/lib/maw/quality-gates
WORKDIR /var/lib/maw/quality-gates

USER 10005:10005

EXPOSE 8003

# Liveness probe against the auth-exempt /health endpoint.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8003/health',timeout=3).status==200 else 1)"

# Exec-form CMD (no shell): the module runs as PID 1 and receives signals directly.
CMD ["python", "-m", "quality_gates.main", "--host", "0.0.0.0", "--port", "8003"]
