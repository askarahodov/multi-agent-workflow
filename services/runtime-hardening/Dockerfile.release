# services/runtime-hardening — production release image (source-baked).
#
# Unlike services/runtime-hardening/Dockerfile (the local-dev image, which installs runtime
# dependencies into /app/.venv and relies on docker-compose bind-mounting the
# source tree), this image COPYs the application source. The published artifact
# is therefore standalone-runnable: `docker run` boots the API with no host bind
# mounts.
#
# Build context is the repository ROOT (release.yml builds with context: ".").
# Base image: python:3.12-slim — the same base as the hardened variants. This
# repository does not pin base-image digests.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /opt/maw

# First-party shared package plus the subsystem source. `shared` is installed
# first so the `maw-shared==0.1.0` requirement in services/runtime-hardening's pyproject
# resolves locally instead of hitting PyPI.
COPY packages/shared /opt/maw/shared
COPY services/runtime-hardening /opt/maw/runtime-hardening

# Install the packages (pulls runtime deps from services/runtime-hardening/pyproject.toml)
# and create the dedicated non-root service identity. uid/gid 10003 follows the
# project-wide release-image convention.
RUN python -m pip install --no-cache-dir \
        /opt/maw/shared /opt/maw/runtime-hardening \
    && useradd --system --uid 10003 --no-create-home --shell /usr/sbin/nologin maw-runtime \
    && rm -rf /root/.cache/pip

# Writable state directory for the non-root runtime.
RUN install -d -o 10003 -g 10003 /var/lib/maw/runtime
WORKDIR /var/lib/maw/runtime

USER 10003:10003

EXPOSE 8002

# The /health endpoint needs no container-runtime access, so the liveness probe
# works even without the mounts below.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8002/health',timeout=3).status==200 else 1)"

# ---------------------------------------------------------------------------
# PRIVILEGED SERVICE — operator requirements (documented, not baked in)
#
# services/runtime-hardening is privileged by design: it manages agent containers and
# cgroup v2 quotas, so unlike the other release images it cannot run fully
# isolated. To exercise its container/cgroup features the operator must run the
# container with:
#
#   docker run --privileged \
#     -v /var/run/docker.sock:/var/run/docker.sock \
#     -v /sys/fs/cgroup:/sys/fs/cgroup:ro \
#     -v /var/lib/agent-runtime:/var/lib/agent-runtime \
#     ... ghcr.io/<repo>-runtime-hardening:<version>
#
# The process still runs as the non-root uid 10003; the operator must grant that
# uid access to the Docker socket (e.g. `--group-add $(getent group docker | cut -d: -f3)`
# or a socket owned by a shared group) and to /var/lib/agent-runtime. Without
# those mounts the API still boots and serves /health, but container/cgroup
# operations fail closed.
# ---------------------------------------------------------------------------

# Exec-form CMD (no shell): uvicorn runs as PID 1 and receives signals directly.
CMD ["python", "-m", "uvicorn", "runtime.main:app", "--host", "0.0.0.0", "--port", "8002"]
